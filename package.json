{
  "name": "slakten",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/lib/tsc.js -b && node node_modules/vite/bin/vite.js build",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test:rings": "node --experimental-strip-types --test tests/ringTree.test.mjs tests/ringColor.test.mjs tests/ringLabels.test.mjs tests/ringZoom.test.mjs",
    "test:locations": "node --experimental-strip-types --test tests/geocoder.test.mjs tests/locationCache.test.mjs tests/locationReview.test.mjs tests/geonamesReview.test.mjs",
    "locations:check": "node --experimental-strip-types scripts/build-location-cache.mjs",
    "locations:build": "node --experimental-strip-types scripts/build-location-cache.mjs --output public/locations.json",
    "locations:candidates": "node --experimental-strip-types scripts/build-geonames-review.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "@xyflow/react": "^12.10.1",
    "dagre": "^0.8.5",
    "leaflet": "^1.9.4",
    "parse-gedcom": "^2.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
